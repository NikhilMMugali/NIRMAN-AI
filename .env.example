# NIRMAN AI — Root Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO THIS FILE

# Application & Environment Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API Base URL (used by Next.js client)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Cloud Database & Supabase Integration (Optional for local Parquet fallback)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM / AI Assistance Providers (Optional for local deterministic decision support)
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=
